{
  "name": "up70-vision",
  "build": {
    "dockerfile": "${localWorkspaceFolder}/.devcontainer/Dockerfile",
    "context": "${localWorkspaceFolder}"
  },
  "workspaceFolder": "/opt/vision",
  "workspaceMount": "source=${localWorkspaceFolder},target=/opt/vision,type=bind",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },
  "postCreateCommand": "python -m vision doctor"
}
