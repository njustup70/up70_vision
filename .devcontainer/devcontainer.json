{
  "name": "up70-vision",
  "build": {
    "dockerfile": "${localWorkspaceFolder}/.devcontainer/Dockerfile",
    "context": "${localWorkspaceFolder}"
  },
  "workspaceFolder": "/opt/up70_vision",
  "workspaceMount": "source=${localWorkspaceFolder},target=/opt/up70_vision,type=bind",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },
  "postCreateCommand": "python scripts/check_env.py"
}
